# QA-MCP configuration.
#
# Copy to `.env` and fill in. Every value is also settable as a plain
# environment variable, which is what you want in Docker or Kubernetes.
# QA-MCP runs fully offline with none of this set.
#
#   qa-mcp --check-config    validates these and prints what would be exposed

# --- Server ------------------------------------------------------------------
# DEBUG, INFO, WARNING, ERROR, CRITICAL
QA_MCP_LOG_LEVEL=INFO
# Log every tool call (names of arguments only, never their values)
QA_MCP_AUDIT_LOG_ENABLED=true
# Also publish the pre-1.0.3 dotted tool names (testcase.lint, ...)
QA_MCP_LEGACY_TOOL_ALIASES=false

# --- Quality gate ------------------------------------------------------------
# Raise these to hold your team to a higher bar than the shipped default.
QA_MCP_LINT_MINIMUM_SCORE=60
QA_MCP_LINT_STRICT_MINIMUM_SCORE=75
QA_MCP_LINT_MAX_STEPS=15
# Rules your organisation does not enforce, as a JSON array.
# Ids come from the qa://checklists/lint-rules/v1 resource.
# QA_MCP_LINT_DISABLED_RULES=["tags.recommended","requirements.recommended"]

# --- Jira / Xray -------------------------------------------------------------
# Leave QA_MCP_XRAY_ENABLED unset to run offline. When it is true, the
# credentials below are validated at startup rather than on first use.
#
# NOTE ON MCP CLIENTS: a stdio MCP server does not inherit your shell
# environment, and this file is read relative to the server's working
# directory, which the client chooses. When QA-MCP is launched by Claude
# Desktop or a similar client, put these in the client's "env" block instead.
# This file is for Docker (--env-file), systemd, and local development.
QA_MCP_XRAY_ENABLED=false

# 'cloud' for Jira Cloud + Xray Cloud, 'server' for Jira Server / Data Center.
# The two host Xray behind completely different APIs, so this must be right.
QA_MCP_XRAY_DEPLOYMENT=cloud

# --- Jira credentials (both deployments) -------------------------------------
# Reads and creates issues.
# https://your-tenant.atlassian.net  (Cloud)  or  https://jira.internal  (DC)
# QA_MCP_XRAY_BASE_URL=
# '3' for Jira Cloud, '2' for Server / Data Center
# QA_MCP_XRAY_API_VERSION=3

# Jira Cloud: auth_mode=basic with your account email and an API token
#   https://id.atlassian.com/manage-profile/security/api-tokens
# Server / Data Center: auth_mode=token with a personal access token
# QA_MCP_XRAY_AUTH_MODE=basic
# QA_MCP_XRAY_EMAIL=qa-automation@your-company.com
# QA_MCP_XRAY_API_TOKEN=

# --- Xray Cloud API Key (Cloud only) -----------------------------------------
# Xray Cloud keeps test steps outside Jira and exposes them only through its own
# API, behind a SEPARATE credential. Without these, a test can be created but
# its steps cannot be imported, so QA-MCP refuses rather than silently
# producing a Test with no steps.
#
# Create one at: Jira -> Apps -> Xray -> Global Settings -> API Keys
# This is NOT the Jira API token above.
# QA_MCP_XRAY_CLIENT_ID=
# QA_MCP_XRAY_CLIENT_SECRET=
# QA_MCP_XRAY_CLOUD_BASE_URL=https://xray.cloud.getxray.app
#
# Server / Data Center needs none of this: Xray lives on the Jira host under
# /rest/raven and accepts the Jira credentials.

# --- Project defaults --------------------------------------------------------
# QA_MCP_XRAY_PROJECT_KEY=QA
# QA_MCP_XRAY_TEST_ISSUE_TYPE=Test

# Xray custom field ids are per-tenant; read them from your Jira admin.
# QA_MCP_XRAY_CUSTOM_FIELDS={"risk_level":"customfield_10001","scenario_type":"customfield_10002"}

# QA_MCP_XRAY_TIMEOUT_SECONDS=30
# QA_MCP_XRAY_MAX_RETRIES=2
# Set false only for an internal CA in a test environment.
# QA_MCP_XRAY_VERIFY_TLS=true

# --- Write access ------------------------------------------------------------
# Off by default. When true, xray_create_test is published and can create
# issues in the project above. Requires a configured tenant.
QA_MCP_ENABLE_WRITE_TOOLS=false
